# Copy to .env and fill in. Never commit .env.
# Per-user API tokens, format user:token,user:token. Use long random values.
API_TOKENS=alice:change-me-alice,bob:change-me-bob
# Admin token: can read /usage for every user and /drift.
ADMIN_TOKEN=change-me-admin
# Postgres password used by docker compose.
POSTGRES_PASSWORD=change-me-db
# Where the API takes its model from: "mlflow" (registry alias) or "file".
MODEL_SOURCE=mlflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_NAME=eurosat-classifier
MODEL_ALIAS=production
# Used when MODEL_SOURCE=file.
MODEL_PATH=models/release/eurosat_int8.onnx
# Comma separated browser origins allowed by CORS.
CORS_ORIGINS=http://127.0.0.1:8080
